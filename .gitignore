# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules/

# ─── Next.js ──────────────────────────────────────────────────────────────────
.next/
out/

# ─── Build artifacts (scoped to avoid catching source dirs named "build") ─────
dist/
build/
backend/dist/
backend/build/
frontend/dist/
frontend/build/
indexer/dist/
indexer/build/

# ─── Environment files ────────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.testnet

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── OS files ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Coverage reports ─────────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Test snapshots ───────────────────────────────────────────────────────────
**/__snapshots__/
*.snap

# ─── Jest / Vitest cache ──────────────────────────────────────────────────────
.jest-cache/
jest_0/
.jest/
.vitest/

# ─── TypeScript build info ────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Editor directories ───────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ─── Temp files ───────────────────────────────────────────────────────────────
*.tmp

# ─── Prisma generated client (regenerated by db:generate) ────────────────────
backend/src/generated/

# ─── Soroban / Rust build artifacts ──────────────────────────────────────────
contracts/target/
contracts/scripts/.env.testnet
**/*.wasm

# ─── Storybook static build ───────────────────────────────────────────────────
storybook-static/

# ─── Package manager lock files (keep package-lock.json, ignore the rest) ────
yarn.lock
pnpm-lock.yaml

# ─── Claude / AI tooling ─────────────────────────────────────────────────────
.claude/

# ─── Misc repo artifacts ──────────────────────────────────────────────────────
treasury_changes.txt
